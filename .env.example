# Source des données :
#  - "mock" (défaut) : faux back-end en mémoire (src/mocks/server/MockServer.ts), aucun appel réseau.
#  - "http" : adaptateurs Http* contre le vrai back-end FastAPI (quizmo_backend), via le proxy Vite
#    /api → http://localhost:8000. Lancer le back-end avec un enseignant de démonstration :
#      QUIZMO_UTILISATEUR_DEV=enseignantA uv run fastapi dev app/main.py
#    puis : VITE_API_MODE=http npm run dev
VITE_API_MODE=mock
# Latence simulée des mocks (ms, mode "mock" uniquement)
VITE_MOCK_LATENCY_MS=400
